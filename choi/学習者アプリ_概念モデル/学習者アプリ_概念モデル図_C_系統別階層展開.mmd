flowchart TB

subgraph 企画系["企画系 (デッキタイプ=talk / カードタイプ=企画系)"]
    direction TB
    P_C["カード<br/>(単語種別集合なし)"]
    P_S1["会話シーン<br/>通常1シーン<br/>talkType=コンテンツ依存"]
    P_S2["会話シーン<br/>(ガイドトーク系のみ)<br/>前半・後半に分かれる"]
    P_T1["センテンス × 4<br/>(話者2人 × 2ターン)"]
    P_T2["センテンス × 4"]
    P_C --> P_S1 --> P_T1
    P_C -.->|ガイドトーク系の場合| P_S2 --> P_T2
    P_S1 -.->|内容として連続| P_S2
end

subgraph 語彙系["語彙系 (デッキタイプ=word / カードタイプ=語彙系)"]
    direction TB
    W_C["カード<br/>1単語<br/>単語種別集合={一般, タメ}"]
    W_S1["会話シーン<br/>talkType=general / toeic<br/>(種別 一般)"]
    W_S2["会話シーン<br/>talkType=sns<br/>(種別 タメ)"]
    W_T1["センテンス × 4"]
    W_T2["センテンス × 4"]
    W_C --> W_S1 --> W_T1
    W_C --> W_S2 --> W_T2
end

subgraph ニュース系["ニュース系 (デッキタイプ=news / カードタイプ=ニュース系)"]
    direction TB
    N_C["カード<br/>1記事<br/>(単語種別集合なし)"]
    N_S1["会話シーン<br/>前半"]
    N_S2["会話シーン<br/>後半"]
    N_T1["センテンス × 4<br/>(ニュース系は多めの可能性あり)"]
    N_T2["センテンス × 4"]
    N_C --> N_S1 --> N_T1
    N_C --> N_S2 --> N_T2
    N_S1 -.->|記事の内容として連続| N_S2
end

subgraph 判定["判定の基本ルール（v14・C-2主担当）"]
    direction TB
    R1["各問題種別の判定は<br/>直近2試行の正誤履歴で行う:<br/><br/>クリア: 直近2試行が両方正解<br/>弱点: 直近2試行が両方不正解<br/>学習中: それ以外（試行歴あり）<br/>未学習: まだ試行していない<br/><br/>実装の具体的な判定式は概念モデル外<br/>（ソースコード参照）"]
end

subgraph 成績["カード成績・単語成績（v14・C-2主担当）"]
    direction TB
    A1["カード成績は全カードに必ず1件存在<br/>会員×カードで1件<br/><br/>カード成績.ステータス（4値）:<br/>未学習 / 学習中 / クリア / 弱点<br/><br/>軸分離なし・対象外enumなし<br/>（種別はカード側の属性で表現するため）"]
    A2["単語成績は語彙系カードのみ存在<br/>会員×カードで0..1件<br/>（企画系・ニュース系には存在しない）<br/><br/>単語成績.ステータス（4値）:<br/>未学習 / 学習中 / クリア / 弱点"]
    A1 --> A2
end

subgraph 習得["カード習得と階層伝搬（v14追加）"]
    direction TB
    H1["カード習得 = カード成績クリア<br/>（語彙系は単語成績も同時にクリア要）<br/><br/>UI上は習得マーク（チェックマーク）として表示<br/>例：whenの単語カードを習得"]
    H2["階層伝搬:<br/><br/>カード習得（全カード）<br/>　↓<br/>デッキ成績.ステータス = 習得（全カードが習得）<br/>　↓<br/>パート成績.ステータス = 習得（全デッキが習得）<br/>　↓<br/>ユニット成績.ステータス = 習得（全パートが習得）<br/>　↓<br/>コース成績.ステータス = 習得（全ユニットが習得）<br/><br/>各階層の成績エンティティはB-1参照。"]
    H3["系統別のカード習得条件:<br/><br/>【企画系・ニュース系】<br/>カード成績クリア = カード習得<br/>　・会話問題のクリアのみ判定対象<br/><br/>【語彙系】<br/>カード成績クリア＋単語成績クリア = カード習得<br/>　・単語問題（単語成績） : 英日／日英／スペル<br/>　・会話問題（カード成績） : 一般／タメ<br/>すべての問題種別を直近2試行両方正解で<br/>クリアした状態が必要"]
    H1 --> H2
    H2 --> H3
end

subgraph 凡例["凡例・補足"]
    direction TB
    L1["カード属性 (v13・C-1参照):<br/>タイプ ∈ { 語彙系, 企画系, ニュース系 }<br/>単語種別集合 ⊆ { 一般, タメ } (語彙系のみ)"]
    L2["1シーンの標準センテンス数 = 4<br/>(話者2人 × 2ターンの会話)"]
    L3["1カードが2シーンを持つ場合<br/>カード単位の総センテンス数は8"]
    L4["ガイドトーク系の判定方法は次フェーズで詳細設計"]
end
